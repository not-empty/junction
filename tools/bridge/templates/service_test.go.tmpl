func TestCreateReturnsTheNewID(t *testing.T) {
	service := New{{.Pascal}}Service(repositoryMock{
		create: func(ctx context.Context, {{.Camel}} domain.{{.Pascal}}Register) (string, error) {
			return "an-id", nil
		},
	})

	id, err := service.Create(context.Background(), domain.{{.Pascal}}Register{Name: "a name"})
	if err != nil {
		t.Fatal(err)
	}

	if id != "an-id" {
		t.Errorf("got id %q, want %q", id, "an-id")
	}
}

