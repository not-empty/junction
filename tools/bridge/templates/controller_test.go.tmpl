func TestGetOneRespondsNotFound(t *testing.T) {
	controller := New{{.Pascal}}Controller(serviceMock{
		getOne: func(ctx context.Context, id string) (domain.{{.Pascal}}, error) {
			return domain.{{.Pascal}}{}, apperror.New(apperror.NotFound, "register not found")
		},
	})

	recorder := httptest.NewRecorder()
	request := httptest.NewRequest(http.MethodGet, "/{{.Kebab}}/an-id", nil)
	request.SetPathValue("id", "an-id")

	controller.GetOne(recorder, request)

	assertStatus(t, recorder, http.StatusNotFound)
}

func TestCreateRejectsAnInvalidBody(t *testing.T) {
	controller := New{{.Pascal}}Controller(serviceMock{
		create: func(ctx context.Context, input domain.{{.Pascal}}Register) (string, error) {
			t.Fatal("the service must not be reached when the body is invalid")
			return "", nil
