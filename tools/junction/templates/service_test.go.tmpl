func make{{.Pascal}}List(size int) []domain.{{.Pascal}} {
	{{.Camel}}List := make([]domain.{{.Pascal}}, size)

	for i := range {{.Camel}}List {
		{{.Camel}}List[i].ID = fmt.Sprintf("id-%02d", i)
	}

	return {{.Camel}}List
}

func assertKind(t *testing.T, err error, want apperror.Kind) {
	t.Helper()

	var appErr *apperror.Error

	if !errors.As(err, &appErr) {
		t.Fatalf("got %v, want an *apperror.Error", err)
	}

	if appErr.Kind != want {
		t.Fatalf("got kind %v, want %v", appErr.Kind, want)
	}
}
