func job(payload string) queue.Job {
	return queue.Job{ID: "a-job", Payload: []byte(payload)}
}

func TestCreateHandsThePayloadToTheService(t *testing.T) {
	id := database.NewID()
	received := domain.{{.Pascal}}Register{}

	consumer := New{{.Pascal}}Consumer(serviceMock{
		create: func(ctx context.Context, input domain.{{.Pascal}}Register) (string, error) {
			received = input
			return input.ID, nil
		},
	})

	err := consumer.Create(context.Background(), job(fmt.Sprintf(`{"id":%q,"name":"a name"}`, id)))
	if err != nil {
		t.Fatal(err)
	}

	if received.ID != id {
		t.Errorf("got id %q, want %q", received.ID, id)
	}

	if received.Name != "a name" {
		t.Errorf("got name %q, want %q", received.Name, "a name")
	}
}

func TestCreateRejectsAMissingID(t *testing.T) {
	consumer := New{{.Pascal}}Consumer(serviceMock{
		create: func(ctx context.Context, input domain.{{.Pascal}}Register) (string, error) {
			t.Fatal("the service must not be reached without an id")
			return "", nil
		},
	})

	err := consumer.Create(context.Background(), job(`{"name":"a name"}`))

	assertKind(t, err, apperror.BadRequest)
}

func TestCreateRejectsAnIDThatIsNotAULID(t *testing.T) {
	consumer := New{{.Pascal}}Consumer(serviceMock{
