func TestListWithoutAnotherPageReturnsNoCursor(t *testing.T) {
	service := New{{.Pascal}}Service(repositoryMock{
		list: func(ctx context.Context, cursor string) ([]domain.{{.Pascal}}, error) {
			return make{{.Pascal}}List(domain.DefaultPageSize), nil
		},
	})

	{{.Camel}}List, nextCursor, err := service.List(context.Background(), "")
	if err != nil {
		t.Fatal(err)
	}

	if len({{.Camel}}List) != domain.DefaultPageSize {
		t.Errorf("got %d items, want %d", len({{.Camel}}List), domain.DefaultPageSize)
	}

	if nextCursor != "" {
		t.Errorf("got cursor %q, want none", nextCursor)
	}
}

func TestListWithAnotherPageTrimsAndReturnsTheCursor(t *testing.T) {
	service := New{{.Pascal}}Service(repositoryMock{
		list: func(ctx context.Context, cursor string) ([]domain.{{.Pascal}}, error) {
			if cursor != validCursor {
				t.Errorf("got cursor %q, want %q", cursor, validCursor)
			}

			return make{{.Pascal}}List(domain.DefaultPageSize + 1), nil
		},
	})

	{{.Camel}}List, nextCursor, err := service.List(context.Background(), validCursor)
	if err != nil {
		t.Fatal(err)
	}

	if len({{.Camel}}List) != domain.DefaultPageSize {
		t.Errorf("got %d items, want %d", len({{.Camel}}List), domain.DefaultPageSize)
	}

	last := {{.Camel}}List[len({{.Camel}}List)-1].ID
	if nextCursor != last {
		t.Errorf("got cursor %q, want the last item id %q", nextCursor, last)
	}
}

