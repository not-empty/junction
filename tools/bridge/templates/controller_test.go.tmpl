func TestRegisterRoutesMountsEveryRoute(t *testing.T) {
	mux := http.NewServeMux()

	registerRoutes(mux, New{{.Pascal}}Controller(serviceMock{}))

	routes := []struct {
		method string
		path   string
	}{
		{http.MethodPost, "/{{.Kebab}}/add"},
		{http.MethodGet, "/{{.Kebab}}/list"},
		{http.MethodGet, "/{{.Kebab}}/an-id"},
		{http.MethodPatch, "/{{.Kebab}}/an-id"},
		{http.MethodDelete, "/{{.Kebab}}/an-id"},
	}

	for _, route := range routes {
		_, pattern := mux.Handler(httptest.NewRequest(route.method, route.path, nil))

		if pattern == "" {
			t.Errorf("no route registered for %s %s", route.method, route.path)
		}
	}
}

// Exercises routing, the {id} path value and the controller, mocking only the service.
func TestGetOneServesThroughTheMux(t *testing.T) {
	mux := http.NewServeMux()

	registerRoutes(mux, New{{.Pascal}}Controller(serviceMock{
		getOne: func(ctx context.Context, id string) (domain.{{.Pascal}}, error) {
			return domain.{{.Pascal}}{ID: id, Name: "a name"}, nil
		},
	}))

	recorder := httptest.NewRecorder()
	mux.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/{{.Kebab}}/an-id", nil))

	assertStatus(t, recorder, http.StatusOK)

	var body domain.{{.Pascal}}

	err := json.Unmarshal(recorder.Body.Bytes(), &body)
	if err != nil {
		t.Fatal(err)
	}

	if body.ID != "an-id" {
		t.Errorf("got id %q, want %q: the {id} path value did not reach the service", body.ID, "an-id")
	}

	if body.Name != "a name" {
		t.Errorf("got name %q, want %q", body.Name, "a name")
	}
}

func assertStatus(t *testing.T, recorder *httptest.ResponseRecorder, want int) {
	t.Helper()

	if recorder.Code != want {
		t.Fatalf("got status %d, want %d: %s", recorder.Code, want, recorder.Body)
	}
}
