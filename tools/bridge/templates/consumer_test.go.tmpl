func TestRegisterQueuesResolvesTheHandler(t *testing.T) {
	registry := queue.Registry{}

	registerQueues(registry, New{{.Pascal}}Consumer(serviceMock{}))

	handler, ok := registry["{{.Kebab}}.create"]
	if !ok {
		t.Fatalf("no handler registered for %q", "{{.Kebab}}.create")
	}

	err := handler(context.Background(), job(fmt.Sprintf(`{"id":%q,"name":"a name"}`, database.NewID())))
	if err != nil {
		t.Fatal(err)
	}
}

func assertKind(t *testing.T, err error, want apperror.Kind) {
	t.Helper()

	var appErr *apperror.Error

	if !errors.As(err, &appErr) {
		t.Fatalf("got %v, want an *apperror.Error", err)
	}

	if appErr.Kind != want {
		t.Fatalf("got kind %v, want %v", appErr.Kind, want)
	}
}
