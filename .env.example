CORS_ALLOWED_ORIGINS=*

# mysql or postgres. Keep DATABASE_DSN on the same database.
DATABASE_DRIVER=mysql
DATABASE_DSN=junction:junction@tcp(localhost:3306)/junction
# DATABASE_DSN=postgres://junction:junction@localhost:5432/junction?sslmode=disable

# Starts only the database DATABASE_DRIVER picks.
COMPOSE_PROFILES=${DATABASE_DRIVER:-mysql}

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=junction
KAFKA_PORT=9092

MAX_BODY_BYTES=1048576

MIGRATIONS_TABLE=schema_migrations

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=junction
MYSQL_USER=junction
MYSQL_PASSWORD=junction
MYSQL_PORT=3306

PORT=8080

# POSTGRES_DB=junction
# POSTGRES_USER=junction
# POSTGRES_PASSWORD=junction
# POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
