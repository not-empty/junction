	query := "SELECT id FROM {{.Table}} WHERE deleted_at IS NULL"
	args := []any{}

	if cursor != "" {
		query += " AND id < ?"
		args = append(args, cursor)
	}

	query += " ORDER BY id DESC LIMIT ?"
	args = append(args, domain.DefaultPageSize+1)

	return database.QueryMany(
