	now := time.Now().UTC().Truncate(time.Microsecond)

	affected, err := database.Exec(
		ctx,
		r.db,
		"UPDATE {{.Table}} SET name = ?, updated_at = ? WHERE id = ? AND deleted_at IS NULL",
		{{.Camel}}.Name, now, id,
	)

	if err != nil {
		return err
	}

	if affected == 0 {
