	})

	recorder := httptest.NewRecorder()
	request := httptest.NewRequest(http.MethodPost, "/{{.Kebab}}/add", strings.NewReader(`{}`))

	controller.Create(recorder, request)

	assertStatus(t, recorder, http.StatusUnprocessableEntity)
}

